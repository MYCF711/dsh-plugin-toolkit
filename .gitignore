# Dependencies — this plugin has none
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local environment
.env
.env.local

# NOTE: lib/ is intentionally NOT ignored.
# The DSH runtime consumes built artifacts directly and has no install-time
# build step for plugins, so the built entry must be committed.
